<odoo>
    <record id="view_order_form_inherit_dynamic_so_advance_payment" model="ir.ui.view">
        <field name="name">view.order.form.inherit.dynamic.sale.advance.payment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_advance_payment"
                    icon="fa-money" invisible="advance_payment_count == 0">
                    <field string="Advance Payment" name="advance_payment_count" widget="statinfo" />
                </button>
            </div>
            <xpath expr="//header" position="inside">
                <button name="action_open_advance_payment" string="Advance Payment" type="object"
                    class="oe_highlight" invisible="state not in ['sale', 'done']" />
            </xpath>
            <field name="payment_term_id" position="after">
                <field name="advance_payment_amount" />
            </field>
        </field>
    </record>
</odoo>