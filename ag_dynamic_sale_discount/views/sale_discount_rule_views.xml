<odoo>
    <record id="sale_discount_rule_view_tree" model="ir.ui.view">
        <field name="name">sale.discount.rule.view.tree</field>
        <field name="model">sale.discount.rule</field>
        <field name="arch" type="xml">
            <list string="Sale Discount Rule">
                <field name="name" />
                <field name="min_amount" />
                <field name="max_amount" />
                <field name="discount_percent" />
                <field name="customer_group" />
                <field name="valid_from" />
                <field name="valid_to" />
            </list>
        </field>
    </record>

    <record id="sale_discount_rule_view_form" model="ir.ui.view">
        <field name="name">sale.discount.rule.view.form</field>
        <field name="model">sale.discount.rule</field>
        <field name="arch" type="xml">
            <form string="Sale Discount Rule">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="min_amount" />
                            <field name="max_amount" />
                            <field name="discount_percent" />
                        </group>
                        <group>
                            <field name="customer_group" />
                            <field name="valid_from" />
                            <field name="valid_to" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_discount_rule_action" model="ir.actions.act_window">
        <field name="name">Sale Discount Rule</field>
        <field name="res_model">sale.discount.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="sale_discount_rule_menu"
        name="Sale Discount Rule"
        action="sale_discount_rule_action"
        parent="sale.menu_sale_config"
        sequence="10" />
</odoo>